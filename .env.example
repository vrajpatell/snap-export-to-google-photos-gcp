# The primary Vercel deployment is browser-only and does not require root backend
# environment variables. Configure frontend/.env.example values in Vercel instead.
#
# Keep this file only for optional local FastAPI/legacy backend development.
ENV=dev
APP_NAME=snap-export-to-google-photos
APP_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173

GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/auth/google/callback
PHOTOS_OAUTH_SCOPES=https://www.googleapis.com/auth/photoslibrary.appendonly,openid,email
APP_SESSION_SECRET=replace-with-a-long-random-local-secret
OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-fernet-key-from-python-c-cryptography.fernet.Fernet.generate_key

# Legacy local backend defaults. Do not use these for the free Vercel deployment.
PERSISTENCE_BACKEND=memory
DATABASE_URL=
OAUTH_TOKEN_NAME=google-oauth-refresh-token
STORAGE_BACKEND=local
QUEUE_BACKEND=inline
TASK_TOKEN=dev-task-token

ENFORCE_USER_AUTH=false
ALLOWED_USER_EMAILS=
MAX_STAGED_UPLOAD_SIZE_MB=20480
SERVERLESS_MAX_FILES_PER_INVOCATION=25
