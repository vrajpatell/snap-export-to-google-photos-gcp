# Required for Google Identity Services browser OAuth.
# Create this as a Google OAuth Web application client.
# Add both http://localhost:5173 and your generated Vercel production origin
# such as https://<your-project>.vercel.app to Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Browser-only Vercel deployments do not call a backend API.
# Leave this empty or unset.
VITE_API_BASE_URL=
